# Copiar para .env.local e preencher
# Sem BZZOIRO_TOKEN o pipeline devolve previsões vazia (401 na API).

# ── Bzzoiro Sports API (obrigatório para dados reais) ─────────────────────
BZZOIRO_TOKEN=

# ── Supabase (recomendado para cache + métricas de acurácia) ──────────────
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Client-side (necessário quando houver client que lê supabase) ────────
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
