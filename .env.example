# Supabase Configuration
SUPABASE_PROJECT_ID="your-project-id"
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_your-publishable-key"
SUPABASE_SERVICE_ROLE_KEY="sb_secret_your-service-role-key"

# Bzzoiro Sports Data API Token
BZZOIRO_TOKEN="your-bzzoiro-token"

# Vite client-side variables (must mirror SUPABASE_* for SSR fallback)
VITE_SUPABASE_PROJECT_ID="${SUPABASE_PROJECT_ID}"
VITE_SUPABASE_PUBLISHABLE_KEY="${SUPABASE_PUBLISHABLE_KEY}"
VITE_SUPABASE_URL="${SUPABASE_URL}"
